<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blanco"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true">

            <include
                android:id="@+id/toolbar"
                layout="@layout/layout_toolbar_curva"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginHorizontal="14dp"
                app:titulo="@{@string/title_editar_cita}"
                app:descripcionVolver="@{@string/editar_cita_volver}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_nombre"
                style="@style/Widget.DogApp.CampoOutlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="28dp"
                android:hint="@string/editar_cita_nombre_mascota"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toolbar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nombre"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/negro"
                    android:textSize="16sp"
                    android:maxLength="15" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_raza"
                style="@style/Widget.DogApp.CampoOutlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="16dp"
                android:hint="@string/editar_cita_raza"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/campo_nombre">

                <AutoCompleteTextView
                    android:id="@+id/raza"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/negro"
                    android:textSize="16sp"
                    android:background="@null"
                    android:completionThreshold="2" android:popupBackground="@color/blanco" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_propietario"
                style="@style/Widget.DogApp.CampoOutlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="16dp"
                android:hint="@string/editar_cita_propietario"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/campo_raza">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/propietario"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/negro"
                    android:textSize="16sp"
                    android:maxLength="30" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_telefono"
                style="@style/Widget.DogApp.CampoOutlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="16dp"
                android:hint="@string/editar_cita_telefono"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/campo_propietario">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/telefono"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/negro"
                    android:textSize="16sp"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <ProgressBar
                android:id="@+id/progreso_razas"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="@color/morado"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/campo_raza"
                app:layout_constraintTop_toTopOf="@id/campo_raza"
                app:layout_constraintBottom_toBottomOf="@id/campo_raza" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>
