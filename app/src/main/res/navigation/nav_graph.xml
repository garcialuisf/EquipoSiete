<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.dogapp.view.fragment.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.dogapp.view.fragment.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_nuevaCitaFragment"
            app:destination="@id/nuevaCitaFragment" />
        <action
            android:id="@+id/action_homeFragment_to_detalleCitaFragment"
            app:destination="@id/detalleCitaFragment" />
    </fragment>

    <fragment
        android:id="@+id/nuevaCitaFragment"
        android:name="com.example.dogapp.view.fragment.NuevaCitaFragment"
        android:label="NuevaCitaFragment"
        tools:layout="@layout/fragment_nueva_cita">
        <action
            android:id="@+id/action_nuevaCitaFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/detalleCitaFragment"
        android:name="com.example.dogapp.view.fragment.DetalleCitaFragment"
        android:label="DetalleCitaFragment"
        tools:layout="@layout/fragment_detalle_cita">
        <argument
            android:name="citaId"
            app:argType="integer" />
        <action
            android:id="@+id/action_detalleCitaFragment_to_editarCitaFragment"
            app:destination="@id/editarCitaFragment" />
        <action
            android:id="@+id/action_detalleCitaFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/editarCitaFragment"
        android:name="com.example.dogapp.view.fragment.EditarCitaFragment"
        android:label="EditarCitaFragment"
        tools:layout="@layout/fragment_editar_cita">
        <argument
            android:name="citaId"
            app:argType="integer" />
        <action
            android:id="@+id/action_editarCitaFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/editarCitaFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_editarCitaFragment_to_detalleCitaFragment"
            app:destination="@id/detalleCitaFragment"
            app:popUpTo="@id/editarCitaFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
